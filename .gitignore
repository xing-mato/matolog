# ============================================================
#  MATOlog .gitignore
#  以本目录（MATOlog\）为仓库根。
#  这里的规则只管本目录及其子目录 —— 工作区根目录的文档不归它管。
# ============================================================

# ------------------------------------------------------------
# ★ 签名密钥 —— 绝不入库
# ------------------------------------------------------------
# MATOkey.jks 等于这个应用的身份证：谁拿到它 + 口令，谁就能签出
# 系统认得出是「你的 MATOlog」的包，能覆盖安装到已装机器上。
#
# 为什么现在必须排除（以前是故意留着的）：
#   以前仓库私有、没有远程，密钥的唯一副本就在本机，"别丢"优先于"保密"。
#   现在这个仓库要公开，同一条推理就反过来了 —— 公开 = 全世界都有副本。
#
# 密钥与口令都不丢：密钥留在本机，口令在**仓库外**（上两级）的
# gradle.properties 里，见 app/build.gradle 的 signingConfigs.release。
MATOkey.jks
*.jks
*.keystore

# ------------------------------------------------------------
# 本机构建配置
# ------------------------------------------------------------
local.properties

# ------------------------------------------------------------
# 构建产物（可随时重建，不入库）
# ------------------------------------------------------------
.gradle/
build/

# Gradle 发行包：wrapper 会自己去 services.gradle.org 取，不需要备在这里。
# 注意本机上这份 gradle-8.0-bin.zip 是**坏的**（10 MB，不是有效 zip），
# 留着它只会让人以为能离线构建。
gradle/gradle-*-bin.zip

# ------------------------------------------------------------
# 离线用例的编译输出
# ------------------------------------------------------------
# tools/ 里是纯 Java 的回归用例，源码要入库；
# 编译出来的 .class 不入库（跑一次就重新生成）。
tools/out/
*.class

# 用例跑起来会写出样例导出，不入库
out.json

# ------------------------------------------------------------
# IDE
# ------------------------------------------------------------
.idea/
*.iml
.DS_Store
