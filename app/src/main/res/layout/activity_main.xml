<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/paper">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <!-- 顶栏 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingLeft="@dimen/gutter"
            android:paddingRight="8dp"
            android:paddingTop="14dp"
            android:paddingBottom="10dp">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <TextView
                    android:id="@+id/logo"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/app_name"
                    android:textColor="@color/ink"
                    android:textSize="17sp"
                    android:letterSpacing="0.06"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tagline"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="8dp"
                    android:text="@string/tagline"
                    android:textColor="@color/ink_faint"
                    android:textSize="11sp"
                    android:letterSpacing="0.14" />
            </LinearLayout>

            <ImageButton
                android:id="@+id/btn_search"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:contentDescription="@string/search_title"
                android:background="@drawable/ripple_round"
                android:src="@drawable/ic_search" />

            <ImageButton
                android:id="@+id/btn_more"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:contentDescription="@string/action_more"
                android:background="@drawable/ripple_round"
                android:src="@drawable/ic_more" />
        </LinearLayout>

        <!-- 跨度切换 -->
        <LinearLayout
            android:id="@+id/segment_bar"
            android:layout_width="match_parent"
            android:layout_height="34dp"
            android:layout_marginLeft="@dimen/gutter"
            android:layout_marginRight="@dimen/gutter"
            android:layout_marginBottom="12dp"
            android:orientation="horizontal" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1px"
            android:layout_marginTop="4dp"
            android:background="@color/divider" />

        <ScrollView
            android:id="@+id/scroll"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:fillViewport="true"
            android:scrollbarStyle="outsideOverlay"
            android:overScrollMode="never">

            <FrameLayout
                android:id="@+id/content_frame"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />
        </ScrollView>
    </LinearLayout>

    <Button
        android:id="@+id/fab"
        style="@style/Widget.MATOlog.Button.Primary"
        android:layout_width="wrap_content"
        android:layout_height="44dp"
        android:layout_gravity="bottom|right"
        android:layout_margin="@dimen/gutter"
        android:minWidth="0dp"
        android:paddingLeft="18dp"
        android:paddingRight="18dp"
        android:text="@string/action_add"
        android:textSize="14sp" />

</FrameLayout>
