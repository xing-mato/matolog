<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/paper">

    <!-- 顶栏 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingLeft="10dp"
        android:paddingRight="14dp"
        android:paddingTop="12dp"
        android:paddingBottom="8dp">

        <ImageButton
            android:id="@+id/btn_back"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:contentDescription="@string/action_back"
            android:background="@drawable/ripple_round"
            android:src="@drawable/ic_chevron_left" />

        <TextView
            android:id="@+id/export_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginLeft="4dp"
            android:text="@string/export_title"
            android:textColor="@color/ink"
            android:textSize="16sp"
            android:letterSpacing="0.03" />
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1px"
        android:background="@color/divider" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true"
        android:overScrollMode="never">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="@dimen/gutter">

            <TextView
                style="@style/Text.Section"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/export_range_label" />

            <!-- 范围选项：当天 / 本周 / 本月 / 本年 / 全部日期 / 自选区间 -->
            <LinearLayout
                android:id="@+id/range_list"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:orientation="vertical" />

            <!-- 自选区间：选「自选日期区间」时才出现 -->
            <LinearLayout
                android:id="@+id/custom_box"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:orientation="horizontal"
                android:visibility="gone">

                <LinearLayout
                    android:id="@+id/field_from"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:background="@drawable/bg_field"
                    android:padding="12dp">

                    <TextView
                        style="@style/Text.Faint"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/export_field_from" />

                    <TextView
                        android:id="@+id/text_from"
                        style="@style/Text.Body"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="3dp"
                        android:textSize="15sp" />
                </LinearLayout>

                <View
                    android:layout_width="10dp"
                    android:layout_height="1dp" />

                <LinearLayout
                    android:id="@+id/field_to"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:background="@drawable/bg_field"
                    android:padding="12dp">

                    <TextView
                        style="@style/Text.Faint"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/export_field_to" />

                    <TextView
                        android:id="@+id/text_to"
                        style="@style/Text.Body"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="3dp"
                        android:textSize="15sp" />
                </LinearLayout>
            </LinearLayout>

            <TextView
                android:id="@+id/text_summary"
                style="@style/Text.Faint"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:lineSpacingMultiplier="1.3" />

            <View
                android:layout_width="match_parent"
                android:layout_height="1px"
                android:layout_marginTop="22dp"
                android:layout_marginBottom="18dp"
                android:background="@color/divider" />

            <TextView
                style="@style/Text.Section"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/export_files_label" />

            <CheckBox
                android:id="@+id/check_files"
                style="@style/Widget.MATOlog.CheckBox"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:button="@drawable/bg_check_on"
                android:paddingLeft="13dp"
                android:text="@string/export_files_off" />

            <TextView
                android:id="@+id/text_files_note"
                style="@style/Text.Faint"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:layout_marginLeft="13dp"
                android:lineSpacingMultiplier="1.3"
                android:text="@string/export_files_note" />

            <View
                android:layout_width="match_parent"
                android:layout_height="1px"
                android:layout_marginTop="22dp"
                android:layout_marginBottom="18dp"
                android:background="@color/divider" />

            <TextView
                style="@style/Text.Section"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/export_encrypt_label" />

            <!-- 加密开关：默认勾上（1.3.1 起不再问密令，就一个勾选框） -->
            <CheckBox
                android:id="@+id/check_encrypt"
                style="@style/Widget.MATOlog.CheckBox"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:button="@drawable/bg_check_on"
                android:paddingLeft="13dp"
                android:text="@string/export_encrypt_on" />

            <Button
                android:id="@+id/btn_export"
                style="@style/Widget.MATOlog.Button.Primary"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:layout_marginTop="26dp"
                android:text="@string/export_go" />

        </LinearLayout>
    </ScrollView>
</LinearLayout>
