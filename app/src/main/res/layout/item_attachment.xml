<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:paddingLeft="16dp"
    android:paddingRight="16dp"
    android:paddingTop="12dp"
    android:paddingBottom="12dp">

    <ImageView
        android:id="@+id/attach_icon"
        android:layout_width="16dp"
        android:layout_height="16dp"
        android:contentDescription="@string/attach_section"
        android:src="@drawable/ic_attach" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:layout_marginLeft="10dp"
        android:orientation="vertical">

        <TextView
            android:id="@+id/attach_name"
            style="@style/Text.Body"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="middle"
            android:singleLine="true"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/attach_meta"
            style="@style/Text.Faint"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:singleLine="true"
            android:textSize="11sp" />
    </LinearLayout>

    <TextView
        android:id="@+id/attach_open"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="6dp"
        android:padding="6dp"
        android:text="@string/attach_page_open"
        android:textColor="@color/primary"
        android:textSize="13sp" />

    <ImageView
        android:id="@+id/attach_remove"
        android:layout_width="30dp"
        android:layout_height="30dp"
        android:layout_marginLeft="2dp"
        android:contentDescription="@string/action_delete"
        android:padding="7dp"
        android:src="@drawable/ic_close"
        android:visibility="gone" />

    <TextView
        android:id="@+id/attach_delete"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="2dp"
        android:padding="6dp"
        android:text="@string/action_delete"
        android:textColor="@color/ink_soft"
        android:textSize="13sp" />
</LinearLayout>
