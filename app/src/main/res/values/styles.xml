<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- ======== 文字 ======== -->
    <style name="Text.Body" parent="@android:style/TextAppearance.Material.Subhead">
        <item name="android:textColor">@color/ink</item>
    </style>

    <style name="Text.Muted" parent="@android:style/TextAppearance.Material.Caption">
        <item name="android:textColor">@color/ink_soft</item>
    </style>

    <style name="Text.Faint" parent="@android:style/TextAppearance.Material.Caption">
        <item name="android:textColor">@color/ink_faint</item>
    </style>

    <style name="Text.Mono" parent="@android:style/TextAppearance.Material.Caption">
        <item name="android:textColor">@color/ink_soft</item>
        <item name="android:fontFamily">monospace</item>
    </style>

    <style name="Text.Section" parent="@android:style/TextAppearance.Material.Caption">
        <item name="android:textColor">@color/ink_faint</item>
        <item name="android:letterSpacing">0.14</item>
    </style>

    <!-- 顶部信息条上的字（绿底白字） -->
    <style name="Text.Banner.Context" parent="@android:style/TextAppearance.Material.Caption">
        <item name="android:textColor">#D9FFFFFF</item>
        <item name="android:letterSpacing">0.08</item>
    </style>

    <style name="Text.Banner.Main" parent="@android:style/TextAppearance.Material.Title">
        <item name="android:textColor">#FFFFFFFF</item>
        <item name="android:textSize">21sp</item>
    </style>

    <style name="Text.Banner.Count" parent="@android:style/TextAppearance.Material.Caption">
        <item name="android:textColor">#D9FFFFFF</item>
        <item name="android:textSize">12sp</item>
    </style>

    <!-- ======== 控件 ======== -->
    <style name="Widget.MATOlog.Button" parent="@android:style/Widget.Material.Light.Button">
        <item name="android:background">@drawable/btn_quiet</item>
        <item name="android:textColor">@color/ink</item>
        <item name="android:textSize">13sp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:minWidth">64dp</item>
        <item name="android:minHeight">36dp</item>
        <item name="android:paddingLeft">14dp</item>
        <item name="android:paddingRight">14dp</item>
        <item name="android:letterSpacing">0.04</item>
    </style>

    <style name="Widget.MATOlog.Button.Primary">
        <item name="android:background">@drawable/btn_primary</item>
        <item name="android:textColor">@color/surface</item>
    </style>

    <style name="Widget.MATOlog.ImageButton" parent="@android:style/Widget.Material.Light.ImageButton">
        <item name="android:background">@drawable/ripple_round</item>
        <item name="android:padding">10dp</item>
    </style>

    <style name="Widget.MATOlog.EditText" parent="@android:style/Widget.Material.Light.EditText">
        <item name="android:background">@drawable/bg_field</item>
        <item name="android:textColor">@color/ink</item>
        <item name="android:textColorHint">@color/ink_faint</item>
        <item name="android:padding">14dp</item>
        <item name="android:textSize">15sp</item>
    </style>

    <!-- ======== 片段切换（日/周/月/年）======== -->
    <style name="Widget.MATOlog.Segment" parent="@android:style/Widget.Material.Light.Button.Borderless">
        <item name="android:background">@drawable/seg_background</item>
        <item name="android:textColor">@color/seg_text</item>
        <item name="android:textSize">13sp</item>
        <item name="android:gravity">center</item>
        <item name="android:minWidth">0dp</item>
        <item name="android:minHeight">0dp</item>
        <item name="android:letterSpacing">0.08</item>
    </style>

    <!-- ======== 复选框（导出选项 / 附件）======== -->
    <style name="Widget.MATOlog.CheckBox" parent="@android:style/Widget.Material.Light.CompoundButton.CheckBox">
        <item name="android:textColor">@color/ink</item>
        <item name="android:textSize">15sp</item>
        <item name="android:button">@drawable/bg_check_on</item>
        <item name="android:paddingLeft">13dp</item>
        <item name="android:minHeight">30dp</item>
    </style>

</resources>
