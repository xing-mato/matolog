<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- 基础主题：浅色纸张、低饱和、无多余装饰 -->
    <style name="Theme.MATOlog" parent="@android:style/Theme.Material.Light.NoActionBar">
        <item name="android:colorPrimary">@color/primary</item>
        <item name="android:colorPrimaryDark">@color/primary</item>
        <item name="android:colorAccent">@color/primary</item>
        <item name="android:colorBackground">@color/paper</item>
        <item name="android:windowBackground">@color/paper</item>
        <item name="android:textColorPrimary">@color/ink</item>
        <item name="android:textColorSecondary">@color/ink_soft</item>
        <item name="android:textColorHint">@color/ink_faint</item>
        <item name="android:textColorLink">@color/primary</item>
        <item name="android:windowActionModeOverlay">true</item>
        <item name="android:statusBarColor">@color/paper</item>
        <item name="android:navigationBarColor">@color/paper</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowLightNavigationBar">true</item>
        <item name="android:listDivider">@drawable/divider_hairline</item>
        <item name="android:buttonStyle">@style/Widget.MATOlog.Button</item>
        <item name="android:imageButtonStyle">@style/Widget.MATOlog.ImageButton</item>
        <item name="android:editTextStyle">@style/Widget.MATOlog.EditText</item>
        <item name="android:alertDialogTheme">@style/Theme.MATOlog.Dialog</item>
        <item name="android:datePickerDialogTheme">@style/Theme.MATOlog.Dialog</item>
        <item name="android:timePickerDialogTheme">@style/Theme.MATOlog.Dialog</item>
    </style>

    <style name="Theme.MATOlog.Dialog" parent="@android:style/Theme.Material.Light.Dialog.Alert">
        <item name="android:colorAccent">@color/primary</item>
        <item name="android:colorPrimary">@color/primary</item>
        <item name="android:windowBackground">@drawable/bg_dialog</item>
    </style>

    <!-- 开屏：不留窗口动画，避免和自身的淡出叠在一起 -->
    <style name="Theme.MATOlog.Splash" parent="@style/Theme.MATOlog">
        <item name="android:windowAnimationStyle">@null</item>
    </style>

    <!-- Theme.MATOlog.Transparent 随屏幕分析一同移除（它只服务于授权中转页，
         而那个页面与整条抓屏链路已在 1.3 删掉）。 -->

</resources>
