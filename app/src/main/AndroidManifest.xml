<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!--
      权限说明（本应用刻意保持克制，参考同类应用的取舍后重新核对过一遍）：

      必需（自动记录的核心）：
        PACKAGE_USAGE_STATS   读取前台应用。用户须在「使用情况访问」里手动授予
      保活（前台服务）：
        FOREGROUND_SERVICE + FOREGROUND_SERVICE_SPECIAL_USE
        POST_NOTIFICATIONS    Android 13 起常驻通知要用户同意
      开机自启：
        RECEIVE_BOOT_COMPLETED
      应用名单：
        QUERY_ALL_PACKAGES    列出本机应用供用户挑「不记哪些」

      可选 / 引导型（不授予也能用，只是体验差一点）：
        REQUEST_IGNORE_BATTERY_OPTIMIZATIONS  加入电池优化白名单，减少被回收
      仅旧系统：
        WRITE_EXTERNAL_STORAGE（maxSdk 28）   导出到「下载」目录

      **刻意不要的**：SYSTEM_ALERT_WINDOW（悬浮窗）、后台弹出界面、
      READ_LOGS、READ_SMS 等 —— 一个都不需要，也不该要。
    -->

    <uses-permission
        android:name="android.permission.PACKAGE_USAGE_STATS"
        tools:ignore="ProtectedPermissions" />

    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />

    <!--
      1.3.5 起**没有 INTERNET 权限**：它原先只服务于「自动整理（LLM）」，
      而那一块已按需求整块删除（连同 network_security_config.xml）。
      于是「数据只在本机」重新变成一句**可以直接核**的话，而不是一句要加括号的声明：

          aapt2 dump permissions MATOlog-1.3.5-release.apk

      （原「屏幕画面分析」已在 1.3 移除 —— 实测用不上，且它是最重的一条隐私面：
      要把屏幕内容交给外部模型。移除后 mediaProjection 权限与对应的前台服务类型
      一并去掉了。）
    -->

    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <uses-permission
        android:name="android.permission.QUERY_ALL_PACKAGES"
        tools:ignore="QueryAllPackagesPermission" />

    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />

    <uses-permission
        android:name="android.permission.WRITE_EXTERNAL_STORAGE"
        android:maxSdkVersion="28" />

    <!--
      「读取 app/app 进程」：本应用不使用 android:process 多进程，进程内自己就是
      记录服务的宿主。跨应用进程信息在无 root 环境下拿不到，所以这里只保留
      自身进程可读的能力，不做越权尝试。
    -->

    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
        <intent>
            <action android:name="android.settings.USAGE_ACCESS_SETTINGS" />
        </intent>
        <intent>
            <action android:name="android.settings.ACCESSIBILITY_SETTINGS" />
        </intent>
        <intent>
            <action android:name="android.settings.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />
        </intent>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="https" />
        </intent>
    </queries>

    <application
        android:name=".util.App"
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher"
        android:supportsRtl="true"
        android:theme="@style/Theme.MATOlog">

        <!-- 把应用内的附件交给系统应用打开时用：file:// 从 Android 7 起会被系统拒绝，
             所以走这个只读的小 provider（自己写的，不引支持库） -->
        <provider
            android:name=".util.AttachmentProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true" />

        <!--
          Shizuku 通信入口。authority 必须是 <包名>.shizuku，Shizuku 服务按这个名字来找。
          缺了它，Shizuku 相关的调用全都不可用（功能会退化成手动授权，不影响记录本身）。
          这几个属性与官方库自带的清单一致，这里手工声明是因为我们用 compileOnly/
          implementation 引入，AAR 清单不参与合并。
        -->
        <provider
            android:name=".util.ShizukuEntry"
            android:authorities="${applicationId}.shizuku"
            android:exported="true"
            android:enabled="true">
            <meta-data
                android:name="moe.shizuku.client.V3_SUPPORT"
                android:value="true" />
        </provider>

        <activity
            android:name=".ui.SplashActivity"
            android:exported="true"
            android:noHistory="true"
            android:theme="@style/Theme.MATOlog.Splash">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".ui.MainActivity"
            android:exported="false"
            android:launchMode="singleTop"
            android:windowSoftInputMode="adjustResize" />

        <activity
            android:name=".ui.EditEventActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <activity
            android:name=".ui.LockActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:windowSoftInputMode="adjustResize" />

        <activity
            android:name=".ui.BackupActivity"
            android:exported="false" />

        <activity
            android:name=".ui.ExportActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <activity
            android:name=".ui.AttachmentActivity"
            android:exported="false" />

        <activity
            android:name=".ui.AboutActivity"
            android:exported="false" />

        <activity
            android:name=".ui.SettingsActivity"
            android:exported="false" />

        <!-- 主页关键词检索。windowSoftInputMode=adjustResize 是必须的：
             结果列表在输入法弹起时要跟着让位，否则下面的结果被键盘盖住 -->
        <activity
            android:name=".ui.SearchActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <activity
            android:name=".ui.PermissionsActivity"
            android:exported="false" />

        <activity
            android:name=".ui.AppRulesActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <activity
            android:name=".ui.CacheActivity"
            android:exported="false" />

        <!-- 自动记录常驻服务 -->
        <service
            android:name=".service.RecordService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="用户主动开启的长期记录：按分钟采样前台应用，生成可编辑的事件记录" />
        </service>

        <!-- 无障碍服务已在 1.3 移除。
             真机（iQOO Neo10 / OriginOS 6 / Android 16）上反复被系统关闭，
             抓到根因后确认：它是被系统按进程优先级回收的连带牺牲品，
             而它能带来的只是「分段边界更准」这一项体验提升。
             自动记录在没有它的情况下完整可用（按分钟轮询使用情况），
             代价只是分段边界可能晚几十秒 —— 不值得为这点精度扛住
             厂商 ROM 的反复回收。相关取舍见根目录 更新日志.txt 的 1.3 一节。 -->

        <receiver
            android:name=".service.BootReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.QUICKBOOT_POWERON" />
                <action android:name="android.intent.action.LOCKED_BOOT_COMPLETED" />
            </intent-filter>
        </receiver>

    </application>

</manifest>
